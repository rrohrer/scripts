# ============================================================
#  dunst — gruvbox-material warm notifications
# ============================================================
[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 200)
    origin = top-right
    offset = (18, 54)
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 340

    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#e78a4e"
    gap_size = 6
    separator_color = frame
    sort = yes

    font = Hack Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    corner_radius = 10
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282320"
    foreground = "#a89984"
    frame_color = "#7daea3"
    timeout = 6

[urgency_normal]
    background = "#32302f"
    foreground = "#d4be98"
    frame_color = "#e78a4e"
    timeout = 8

[urgency_critical]
    background = "#32302f"
    foreground = "#d4be98"
    frame_color = "#ea6962"
    timeout = 0
